{
  "name": "brailleme",
  "main": "./geometry-entry.tsx",
  "version": "0.2.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite",
          "react-native-nitro-image"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.14",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-intent-launcher": "57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-tflite": "3.0.1",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-worklets": "5.2.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "eas-cli": "22.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "expo-doctor": "1.20.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:dev-server": "expo start --dev-client --android",
    "eas:login": "eas login",
    "build:dev:android": "npm run model:verify && eas build --platform android --profile development",
    "build:preview:android": "npm run release:config:verify && npm run model:verify && eas build --platform android --profile preview",
    "build:production:android": "npm run release:verify && eas build --platform android --profile production",
    "submit:internal:android": "npm run release:config:verify && npm run model:verify && node scripts/submit-eas-build.mjs internal",
    "submit:production:android": "npm run release:verify && node scripts/submit-eas-build.mjs production",
    "eas-build-post-install": "node scripts/verify-eas-build-profile.mjs",
    "release:config:verify": "node scripts/verify-release-config.mjs",
    "release:model:verify": "node scripts/verify-model-release.mjs",
    "release:verify": "npm run release:config:verify && npm run model:verify && npm run release:model:verify",
    "doctor": "node scripts/run-expo-doctor.mjs",
    "expo:dependencies:check": "expo install --check",
    "audit:dependencies": "npm audit --omit=dev --audit-level=critical",
    "export:android": "expo export --platform android --output-dir dist",
    "lint": "expo lint --no-cache",
    "model:verify": "node scripts/verify-model-assets.mjs && node scripts/verify-word-model-assets.mjs",
    "model:verify:classifier": "node scripts/verify-model-assets.mjs",
    "model:verify:word": "node scripts/verify-word-model-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },
  "private": true
}
